          },
          "expr": "sum(rate(ml_service_http_requests_total{status_code=~\"4..|5..\",path!=\"/metrics\"}[5m])) by (path) / clamp_min(sum(rate(ml_service_http_requests_total{path!=\"/metrics\"}[5m])) by (path), 0.0001)",
